{
  "entities": {
    "User": {
      "title": "User",
      "description": "Healthcare worker or staff member",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { 
          "type": "string", 
          "enum": ["clinician", "nurse", "allied_health", "admin", "billing", "patient"] 
        },
        "specialty": { "type": "string", "description": "e.g. Physiotherapist, Psychologist, Optometrist" },
        "dashboardSettings": {
          "type": "object",
          "description": "Customized dashboard layout for different screen sizes"
        },
        "organizationId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "CareTeamMember": {
      "title": "Care Team Member",
      "description": "Relationship mapping a provider to a patient's care team",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "userId": { "type": "string" },
        "userRole": { "type": "string" },
        "userSpecialty": { "type": "string" },
        "accessLevel": { "type": "string", "enum": ["clinical_full", "clinical_limited", "administrative"] },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "assignedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time", "description": "Automatic revocation of access" }
      },
      "required": ["patientId", "userId", "accessLevel", "status"]
    },
    "Patient": {
      "title": "Patient",
      "description": "Clinical record identifier. Every patient has at least one MRN.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "App Unique ID (links to User.id)" },
        "mrn": { "type": "string", "description": "Medical Record Number - Clinical Primary Key" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "dateOfBirth": { "type": "string", "format": "date" },
        "gender": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "mrn", "firstName", "lastName"]
    },
    "ClinicalRecord": {
      "title": "Clinical Record",
      "description": "SOAP Note for a patient encounter",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "title": { "type": "string" },
        "specialty": { "type": "string" },
        "subjective": { "type": "string" },
        "objective": { "type": "string" },
        "assessment": { "type": "string" },
        "plan": { "type": "string" },
        "icd10Codes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": { "type": "string", "enum": ["draft", "final", "amended", "signed"] },
        "priority": { "type": "string", "enum": ["routine", "urgent", "critical"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "authorId", "status"]
    },
    "Prescription": {
      "title": "Prescription",
      "description": "Medication order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "authorId": { "type": "string" },
        "medicationName": { "type": "string" },
        "dosage": { "type": "string" },
        "route": { "type": "string" },
        "frequency": { "type": "string" },
        "duration": { "type": "string" },
        "durationUnit": { "type": "string" },
        "refills": { "type": "number" },
        "sig": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "completed", "cancelled", "discontinued"] },
        "adherenceStatus": { "type": "string", "enum": ["optimal", "partial", "poor", "uncertain"] },
        "adherenceScore": { "type": "number", "description": "Percentage 0-100" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "authorId", "medicationName", "dosage", "frequency"]
    },
    "Investigation": {
      "title": "Investigation",
      "description": "Lab or imaging order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "authorId": { "type": "string" },
        "category": { "type": "string" },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "testName": { "type": "string" },
              "resultSummary": { "type": "string" }
            }
          }
        },
        "priority": { "type": "string" },
        "indication": { "type": "string" },
        "instructions": { "type": "string" },
        "status": { "type": "string", "enum": ["ordered", "sample_collected", "resulted", "reviewed", "cancelled"] },
        "acknowledgedBy": { "type": "string" },
        "acknowledgedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "authorId", "category", "tests"]
    },
    "InvestigationResult": {
      "title": "Investigation Result",
      "description": "Specific data or file for an investigation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "investigationId": { "type": "string" },
        "testName": { "type": "string" },
        "value": { "type": "string" },
        "units": { "type": "string" },
        "referenceRange": { "type": "string" },
        "interpretation": { "type": "string" },
        "fileUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["investigationId", "testName", "value"]
    },
    "Procedure": {
      "title": "Procedure",
      "description": "Procedure order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "authorId": { "type": "string" },
        "procedureName": { "type": "string" },
        "priority": { "type": "string" },
        "targetDate": { "type": "string", "format": "date" },
        "preparation": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["scheduled", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "authorId", "procedureName"]
    },
    "Referral": {
      "title": "Referral",
      "description": "Specialist referral order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "authorId": { "type": "string" },
        "fromProvider": { "type": "string" },
        "toProvider": { "type": "string" },
        "specialty": { "type": "string" },
        "reason": { "type": "string" },
        "urgency": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "authorId", "specialty", "reason"]
    },
    "Vitals": {
      "title": "Vital Signs",
      "description": "Patient physiological measurements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "hr": { "type": "number" },
        "bp": { "type": "string" },
        "temp": { "type": "number" },
        "rr": { "type": "number" },
        "spo2": { "type": "number" },
        "glucose": { "type": "number" },
        "weight": { "type": "number" },
        "height": { "type": "number" },
        "bmi": { "type": "number" },
        "hba1c": { "type": "number" },
        "gcs": { "type": "string" },
        "timestamp": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId"]
    },
    "Interaction": {
      "title": "Patient Interaction",
      "description": "Any interaction between a healthcare/support worker and the patient",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorRole": { "type": "string", "enum": ["doctor", "nurse", "pt", "social_worker", "financial_counselor", "community_lead"] },
        "type": { "type": "string", "enum": ["clinical", "nursing", "pt", "social_care", "financial", "support_group"] },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "authorId", "authorRole", "type", "content"]
    },
    "Charge": {
      "title": "Clinical Charge",
      "description": "A single billable item or service",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "encounterId": { "type": "string" },
        "clinicianId": { "type": "string" },
        "code": { "type": "string", "description": "CPT or internal code" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["captured", "pending_review", "billed", "void"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "code", "amount", "status"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Aggregated charges for billing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "chargeIds": { "type": "array", "items": { "type": "string" } },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "sent", "partial", "paid", "overdue", "void"] },
        "dueDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "chargeIds", "totalAmount", "status"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Scheduled clinical encounter",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "providerId": { "type": "string" },
        "roomId": { "type": "string" },
        "time": { "type": "string", "format": "date-time" },
        "duration": { "type": "number" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["scheduled", "confirmed", "checked_in", "in_room", "completed", "cancelled", "no_show"] },
        "visitType": { "type": "string", "enum": ["in_clinic", "telehealth"] },
        "priority": { "type": "string", "enum": ["immediate", "urgent", "routine"] },
        "priorityColor": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "time", "reason", "status"]
    },
    "CheckIn": {
      "title": "Patient Check-In",
      "description": "Arrival record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "appointmentId": { "type": "string" },
        "arrivalTime": { "type": "string", "format": "date-time" },
        "insuranceVerified": { "type": "boolean" },
        "outstandingBalance": { "type": "number" },
        "status": { "type": "string", "enum": ["arrived", "triaged", "cancelled"] }
      },
      "required": ["patientId", "arrivalTime", "status"]
    },
    "Consent": {
      "title": "Patient Consent",
      "description": "Legal acknowledgment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "type": { "type": "string", "enum": ["general", "surgical", "hipaa", "telehealth"] },
        "signedAt": { "type": "string", "format": "date-time" },
        "documentUrl": { "type": "string" }
      },
      "required": ["patientId", "type", "signedAt"]
    },
    "SOP": {
      "title": "Standard Operating Procedure",
      "description": "Organizational governance document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "version": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "active", "archived"] },
        "reviewDate": { "type": "string", "format": "date" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "version", "status"]
    },
    "Room": {
      "title": "Clinical Room",
      "description": "Physical or virtual space for encounters",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["exam", "procedure", "telehealth", "consult"] },
        "status": { "type": "string", "enum": ["available", "occupied", "maintenance"] },
        "currentAppointmentId": { "type": "string" }
      },
      "required": ["name", "type", "status"]
    },
    "Reminder": {
      "title": "Reminder",
      "description": "Periodic or one-time reminder for care team or patient",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "assignedToUserId": { "type": "string", "description": "The user who needs to take action" },
        "assignedToRole": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "dueDate": { "type": "string", "format": "date-time" },
        "priority": { "type": "string", "enum": ["routine", "urgent", "immediate"] },
        "status": { "type": "string", "enum": ["pending", "completed", "dismissed"] },
        "frequency": { "type": "string", "enum": ["once", "weekly", "monthly", "yearly"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "completedBy": { "type": "string" }
      },
      "required": ["title", "dueDate", "status"]
    },
    "UserRole": {
      "title": "User Role",
      "description": "RBAC role assignment",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "manager", "clinician", "front_desk", "read_only"] },
        "assignedBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "role"]
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "System audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "performedBy": { "type": "string" },
        "resourceId": { "type": "string" },
        "resourceType": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "details": { "type": "object" }
      },
      "required": ["action", "performedBy", "timestamp"]
    },
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "Clinical supply or medication stock",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["consumables", "medications", "equipment"] },
        "stockLevel": { "type": "number" },
        "minThreshold": { "type": "number" },
        "unit": { "type": "string" },
        "expiryDate": { "type": "string", "format": "date" },
        "location": { "type": "string" },
        "lastRestockedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "stockLevel", "minThreshold"]
    },
    "Task": {
      "title": "Internal Task",
      "description": "Workflow management item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string", "enum": ["clinical", "administrative", "billing", "followup"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "status": { "type": "string", "enum": ["pending", "in_progress", "completed", "archived"] },
        "assignedTo": { "type": "string" },
        "createdBy": { "type": "string" },
        "dueDate": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "priority", "status", "assignedTo"]
    },
    "ClinicalTemplate": {
      "title": "Clinical Template",
      "description": "Structure for clinical notes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["SOAP", "Procedure", "Follow-up"] },
        "fields": { "type": "array", "items": { "type": "object" } },
        "createdBy": { "type": "string" }
      },
      "required": ["name", "type", "fields"]
    }
  },
  "firestore": {
    "/roles/{userId}": {
      "schema": "UserRole",
      "description": "RBAC assignment"
    },
    "/checkins/{checkinId}": {
      "schema": "CheckIn",
      "description": "Daily patient arrival log"
    },
    "/consents/{consentId}": {
      "schema": "Consent",
      "description": "Signed patient acknowledgments"
    },
    "/sops/{sopId}": {
      "schema": "SOP",
      "description": "Organizational governance repository"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Historical audit trail"
    },
    "/rooms/{roomId}": {
      "schema": "Room",
      "description": "Clinical resource management"
    },
    "/clinical_templates/{templateId}": {
      "schema": "ClinicalTemplate",
      "description": "Dynamic documentation structures"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Global clinical schedule"
    },
    "/reminders/{reminderId}": {
      "schema": "Reminder",
      "description": "Reminders for check-ins or tasks"
    },
    "/patients/{patientId}": {
      "schema": "Patient",
      "description": "Patient records"
    },
    "/patients/{patientId}/care_teams/{memberId}": {
      "schema": "CareTeamMember",
      "description": "The specific team of providers assigned to this patient"
    },
    "/patients/{patientId}/clinical_records/{recordId}": {
      "schema": "ClinicalRecord",
      "description": "Patient SOAP notes"
    },
    "/patients/{patientId}/prescriptions/{prescriptionId}": {
      "schema": "Prescription",
      "description": "Patient medications"
    },
    "/patients/{patientId}/investigations/{investigationId}": {
      "schema": "Investigation",
      "description": "Patient lab/imaging orders"
    },
    "/results/{resultId}": {
      "schema": "InvestigationResult",
      "description": "Granular result data"
    },
    "/patients/{patientId}/procedures/{procedureId}": {
      "schema": "Procedure",
      "description": "Patient procedures"
    },
    "/patients/{patientId}/referrals/{referralId}": {
      "schema": "Referral",
      "description": "Patient referrals"
    },
    "/patients/{patientId}/vitals/{vitalId}": {
      "schema": "Vitals",
      "description": "Patient vital signs records"
    },
    "/patients/{patientId}/interactions/{interactionId}": {
      "schema": "Interaction",
      "description": "Historical interactions with care team"
    },
    "/charges/{chargeId}": {
      "schema": "Charge",
      "description": "Financial line items"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Billing records"
    },
    "/inventory/{itemId}": {
      "schema": "InventoryItem",
      "description": "Supply chain management"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Operational task tracking"
    }
  }
}
