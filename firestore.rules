rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function hasRole(role) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/roles/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == role) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role)
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "karlanwartheodore@gmail.com" ||
        hasRole('admin')
      );
    }

    function isManager() {
      return isAdmin() || hasRole('manager');
    }

    function isClinician() {
      return isManager() || hasRole('clinician');
    }

    function isFrontDesk() {
      return isManager() || hasRole('front_desk');
    }

    function isStaff() {
      return isSignedIn() && (
        isAdmin() || 
        isManager() || 
        isClinician() || 
        isFrontDesk() ||
        hasRole('read_only') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['nurse', 'allied_health', 'billing'])
      );
    }

    function isCareTeamMember(patientId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/patients/$(patientId)/care_teams/$(request.auth.uid)) ||
        isAdmin() ||
        isClinician()
      );
    }

    function getCareTeamAccess(patientId) {
      return get(/databases/$(database)/documents/patients/$(patientId)/care_teams/$(request.auth.uid)).data.accessLevel;
    }

    function isAuthor(data) {
      return data != null && (
        (isSignedIn() && data.get('authorId', '') == request.auth.uid) || 
        (data.get('authorId', 'anonymous-entry') == 'anonymous-entry')
      );
    }

    // Global Admin Bypass
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // --- Entity Validations ---
    function isValidUser(data) {
      return data.keys().hasAll(['role']) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
             data.role in ['clinician', 'nurse', 'allied_health', 'admin', 'billing', 'patient'] &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp));
    }

    function isValidPatient(data) {
      return data.keys().hasAll(['firstName', 'lastName']) &&
             data.firstName is string && data.firstName.size() <= 100 &&
             data.lastName is string && data.lastName.size() <= 100;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow list: if isStaff();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if (isSignedIn() && request.auth.uid == userId) && 
                     isValidUser(incoming());
      allow delete: if isAdmin();
    }

    match /roles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow write: if isAdmin();
    }

    match /patients/{patientId} {
      allow get, list: if isSignedIn(); 
      allow create: if (isSignedIn() || (incoming().get('authorId', '') == 'anonymous-entry')) && isValidPatient(incoming());
      allow update: if (isAuthor(existing()) || isStaff()) && isValidPatient(incoming());
      
      match /care_teams/{memberId} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }

      match /clinical_records/{recordId} {
        allow read: if isCareTeamMember(patientId);
        allow create: if isCareTeamMember(patientId) && (isClinician() || isAdmin()) && isValidId(recordId);
        allow write: if isAuthor(existing()) || isAdmin();
      }

      match /prescriptions/{prescriptionId} {
        allow read: if isCareTeamMember(patientId);
        allow write: if isCareTeamMember(patientId) && (isClinician() || isAdmin());
      }

      match /investigations/{investigationId} {
        allow read: if isCareTeamMember(patientId);
        allow write: if isCareTeamMember(patientId) && (isClinician() || isAdmin());
      }

      match /procedures/{procedureId} {
        allow read: if isCareTeamMember(patientId);
        allow write: if isCareTeamMember(patientId) && (isClinician() || isAdmin());
      }

      match /vitals/{vitalId} {
        allow read: if isCareTeamMember(patientId);
        allow create: if isCareTeamMember(patientId);
      }

      match /interactions/{interactionId} {
        allow read: if isCareTeamMember(patientId);
        allow create: if isCareTeamMember(patientId);
      }

      match /health_records/{recordId} {
        allow read: if isCareTeamMember(patientId);
        allow create: if isCareTeamMember(patientId) || isSignedIn();
      }

      match /clinical_intakes/{intakeId} {
        allow read: if isCareTeamMember(patientId);
        allow write: if isCareTeamMember(patientId) || isStaff();
      }
    }

    match /appointments/{appointmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isStaff();
      allow delete: if isAdmin();
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /inventory/{itemId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (incoming().assignedTo == request.auth.uid || isStaff());
    }

    match /reminders/{reminderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.toUserId || request.auth.uid == resource.data.fromUserId);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == resource.data.toUserId;
    }

    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
    }

    match /sops/{sopId} {
      allow read: if isStaff();
      allow write: if isAdmin() || isManager();
    }

    match /charges/{chargeId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /invoices/{invoiceId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /clinical_templates/{templateId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /results/{resultId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /checkins/{checkinId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /consents/{consentId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

  }
}

