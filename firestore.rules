rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helper functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'anonymous');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getRole() {
      return exists(/databases/$(database)/documents/roles/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role 
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role 
            : 'none');
    }

    function hasRole(role) {
      return isSignedIn() && getRole() == role;
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email != null && request.auth.token.email.toLowerCase() == "karlanwartheodore@gmail.com") ||
        hasRole('admin')
      );
    }

    function isAuthor(data) {
      return data != null && (
        (isSignedIn() && data.get('authorId', '') == request.auth.uid) || 
        (data.get('authorId', 'anonymous-entry') == 'anonymous-entry')
      );
    }

    function isManager() { return isAdmin() || hasRole('manager'); }

    function isStaff() {
      return isSignedIn() && (getRole() in ['admin', 'manager', 'clinician', 'nurse', 'allied_health', 'billing', 'read_only']);
    }

    // Role-specific staff helpers
    function isClinician() { return isAdmin() || hasRole('manager') || hasRole('clinician'); }
    function isNurse() { return isClinician() || hasRole('nurse'); }
    function isAlliedHealth() { return isClinician() || hasRole('allied_health'); }
    function isFinancialStaff() { return isAdmin() || hasRole('billing'); }

    function isCareTeamMember(patientId) {
      return isSignedIn() && (
        request.auth.uid == patientId ||
        isAdmin() ||
        exists(/databases/$(database)/documents/patients/$(patientId)/care_teams/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          exists(/databases/$(database)/documents/patients/$(patientId)/care_teams/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('originalId', 'none'))) ||
          exists(/databases/$(database)/documents/patients/$(patientId)/care_teams/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('id', 'none')))
        )) ||
        isClinician() || isNurse() || isAlliedHealth()
      );
    }

    // --- Global Admin Bypass ---
    match /{document=**} {
      // TEMPORARY FOR DEBUGGING ONLY
      allow read, write: if request.auth != null;
    }

    // --- Entity Validations ---
    function isValidUser(data) {
      return data.keys().hasAll(['role']) &&
             data.role in ['clinician', 'nurse', 'allied_health', 'admin', 'billing', 'patient'];
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow list: if isSignedIn() && isStaff(); 
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /roles/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow list: if isSignedIn() && isStaff();
      allow write: if isAdmin();
    }

    match /patients/{patientId} {
      // Allow signed in users to see the demo record for provisioning/demo discovery
      allow get: if isSignedIn() && (isStaff() || request.auth.uid == patientId || patientId == 'sarah-mitchell-42' || patientId == 'p-1');
      allow list: if isSignedIn() && isStaff();
      allow create: if isSignedIn() && (isStaff() || request.auth.uid == patientId || patientId == 'sarah-mitchell-42' || patientId == 'p-1');
      allow update: if isSignedIn() && (isStaff() || request.auth.uid == patientId || patientId == 'sarah-mitchell-42' || patientId == 'p-1');
      
      match /care_teams/{memberId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (isStaff() || request.auth.uid == memberId || patientId == 'p-1' || patientId == 'sarah-mitchell-42');
      }

      match /clinical_records/{recordId} {
        allow read: if isCareTeamMember(patientId);
        allow create: if isCareTeamMember(patientId) && (isClinician() || isNurse() || isAlliedHealth());
        allow update: if isAdmin() || (isAuthor(existing()) && !existing().get('isFinalized', false));
      }

      match /prescriptions/{prescriptionId} {
        allow read: if isCareTeamMember(patientId);
        // Patients can create refill requests (refillRequested: true)
        allow create: if isCareTeamMember(patientId) && (isClinician() || isNurse() || request.auth.uid == patientId);
        allow update: if isCareTeamMember(patientId) && (isClinician() || isNurse());
      }

      match /investigations/{investigationId} {
        allow read: if isCareTeamMember(patientId);
        allow write: if isCareTeamMember(patientId) && (isClinician() || isAdmin());
      }

      match /procedures/{procedureId} {
        allow read: if isCareTeamMember(patientId);
        allow write: if isCareTeamMember(patientId) && (isClinician() || isNurse());
      }

      match /vitals/{vitalId} {
        allow read: if isCareTeamMember(patientId);
        allow create: if isCareTeamMember(patientId) && (isClinician() || isNurse() || isAlliedHealth());
        allow update: if isCareTeamMember(patientId) && (isClinician() || isNurse());
      }

      match /referrals/{referralId} {
        allow read: if isCareTeamMember(patientId) && !isNurse(); // Nurses cannot see referrals
        allow write: if isCareTeamMember(patientId) && (isClinician() || isAlliedHealth());
      }

      match /interactions/{interactionId} {
        allow read: if isCareTeamMember(patientId);
        allow create: if isCareTeamMember(patientId);
      }

      match /health_records/{recordId} {
        allow read: if isCareTeamMember(patientId);
        allow create: if isCareTeamMember(patientId) || isSignedIn();
      }

      match /clinical_intakes/{intakeId} {
        allow read: if isCareTeamMember(patientId);
        allow write: if isCareTeamMember(patientId) || isStaff();
      }
    }

    match /charges/{chargeId} {
      allow read, write: if isFinancialStaff();
    }

    match /invoices/{invoiceId} {
      allow read, write: if isFinancialStaff();
    }

    match /appointments/{appointmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isStaff();
      allow delete: if isAdmin();
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /inventory/{itemId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (incoming().assignedTo == request.auth.uid || isStaff());
    }

    match /reminders/{reminderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.toUserId || request.auth.uid == resource.data.fromUserId);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == resource.data.toUserId;
    }

    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
    }

    match /sops/{sopId} {
      allow read: if isStaff();
      allow write: if isAdmin() || isManager();
    }

    match /clinical_templates/{templateId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /results/{resultId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /checkins/{checkinId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /consents/{consentId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }
  }
}

