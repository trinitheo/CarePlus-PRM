rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role']) &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['doctor', 'nurse', 'admin'];
    }

    function isValidPatient(data) {
      return data.keys().hasAll(['firstName', 'lastName']) &&
             data.firstName is string && data.firstName.size() <= 100 &&
             data.lastName is string && data.lastName.size() <= 100 &&
             (!('authorId' in data) || (data.authorId is string)) &&
             (!('conditions' in data) || (data.conditions is list)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp));
    }

    function isValidClinicalRecord(data) {
      return data.keys().hasAll(['patientId', 'authorId', 'status']) &&
             (data.authorId == 'anonymous-entry' || (request.auth != null && data.authorId == request.auth.uid)) &&
             data.status in ['draft', 'final', 'amended', 'signed'] &&
             (!('title' in data) || (data.title is string && data.title.size() <= 200)) &&
             (!('specialty' in data) || (data.specialty is string && data.specialty.size() <= 100)) &&
             (!('priority' in data) || (data.priority in ['routine', 'urgent', 'critical'])) &&
             (!('subjective' in data) || (data.subjective is string && data.subjective.size() <= 10000)) &&
             (!('objective' in data) || (data.objective is string && data.objective.size() <= 10000)) &&
             (!('assessment' in data) || (data.assessment is string && data.assessment.size() <= 10000)) &&
             (!('plan' in data) || (data.plan is string && data.plan.size() <= 10000)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 20)) &&
             (!('icd10Codes' in data) || (data.icd10Codes is list && data.icd10Codes.size() <= 20)) &&
             (!('workingDiagnoses' in data) || (data.workingDiagnoses is list && data.workingDiagnoses.size() <= 20)) &&
             (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 200)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp));
    }

    function isValidPrescription(data) {
      return data.keys().hasAll(['patientId', 'authorId', 'medicationName', 'dosage', 'frequency', 'status']) &&
             (data.authorId == 'anonymous-entry' || (request.auth != null && data.authorId == request.auth.uid)) &&
             data.medicationName is string && data.medicationName.size() <= 200 &&
             data.dosage is string && data.dosage.size() <= 100 &&
             data.frequency is string && data.frequency.size() <= 100 &&
             data.status in ['active', 'completed', 'cancelled', 'discontinued'] &&
             (!('route' in data) || (data.route is string)) &&
             (!('duration' in data) || (data.duration is string)) &&
             (!('durationUnit' in data) || (data.durationUnit is string)) &&
             (!('refills' in data) || (data.refills is int)) &&
             (!('sig' in data) || (data.sig is string)) &&
             (!('adherenceStatus' in data) || (data.adherenceStatus in ['optimal', 'partial', 'poor', 'uncertain'])) &&
             (!('adherenceScore' in data) || (data.adherenceScore is number)) &&
             (!('authorName' in data) || (data.authorName is string)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp));
    }

    function isValidInvestigation(data) {
      return data.keys().hasAll(['patientId', 'authorId', 'category', 'tests', 'status']) &&
             (data.authorId == 'anonymous-entry' || (request.auth != null && data.authorId == request.auth.uid)) &&
             data.category is string && data.category.size() <= 100 &&
             data.tests is list && data.tests.size() <= 100 &&
             data.status in ['ordered', 'in_progress', 'completed', 'cancelled', 'sample_collected', 'resulted', 'reviewed'] &&
             (!('priority' in data) || (data.priority is string && data.priority.size() <= 100)) &&
             (!('indication' in data) || (data.indication is string && data.indication.size() <= 2000)) &&
             (!('instructions' in data) || (data.instructions is string && data.instructions.size() <= 2000)) &&
             (!('resultSummary' in data) || (data.resultSummary is string && data.resultSummary.size() <= 10000)) &&
             (!('resultDate' in data) || (data.resultDate is string && data.resultDate.size() <= 100)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp));
    }

    function isValidProcedure(data) {
      return data.keys().hasAll(['patientId', 'authorId', 'procedureName', 'status']) &&
             (data.authorId == 'anonymous-entry' || (request.auth != null && data.authorId == request.auth.uid)) &&
             data.procedureName is string && data.procedureName.size() <= 200 &&
             data.status in ['scheduled', 'completed', 'cancelled'] &&
             (!('priority' in data) || (data.priority is string)) &&
             (!('targetDate' in data) || (data.targetDate is string)) &&
             (!('preparation' in data) || (data.preparation is string)) &&
             (!('notes' in data) || (data.notes is string)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp));
    }

    function isValidReferral(data) {
      return data.keys().hasAll(['patientId', 'authorId', 'specialty', 'reason', 'status']) &&
             (data.authorId == 'anonymous-entry' || (request.auth != null && data.authorId == request.auth.uid)) &&
             data.specialty is string && data.specialty.size() <= 200 &&
             data.reason is string && data.reason.size() <= 1000 &&
             data.status in ['pending', 'accepted', 'completed'] &&
             (!('fromProvider' in data) || (data.fromProvider is string)) &&
             (!('toProvider' in data) || (data.toProvider is string)) &&
             (!('urgency' in data) || (data.urgency is string)) &&
             (!('notes' in data) || (data.notes is string)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp));
    }

    function isValidVitals(data) {
      return data.keys().hasAll(['authorId']) &&
             (data.authorId == 'anonymous-entry' || (request.auth != null && data.authorId == request.auth.uid));
             // Simplified validation for now to allow various vitals structures
    }

    function isValidInteraction(data) {
      return data.keys().hasAll(['patientId', 'authorId', 'authorRole', 'type', 'content']) &&
             (data.authorId == 'anonymous-entry' || (request.auth != null && data.authorId == request.auth.uid)) &&
             data.authorRole in ['doctor', 'nurse', 'pt', 'social_worker', 'financial_counselor', 'community_lead'] &&
             data.type in ['clinical', 'nursing', 'pt', 'social_care', 'financial', 'support_group'] &&
             data.content is string && data.content.size() <= 10000;
    }

    // Collection Rules
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && 
                     incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'specialty']) &&
                     isValidUser(incoming());
    }

    match /patients/{patientId} {
      allow get, list: if true; // Allow exploration for demo
      allow create: if (isSignedIn() || incoming().authorId == 'anonymous-entry') && isValidPatient(incoming());
      allow update: if (isSignedIn() || incoming().authorId == 'anonymous-entry') &&
                     isValidPatient(incoming()) &&
                     incoming().diff(existing()).affectedKeys().hasOnly(['firstName', 'lastName', 'dateOfBirth', 'gender', 'conditions', 'updatedAt']);
      
      // Sub-collections
      match /clinical_records/{recordId} {
        allow get, list: if true;
        allow create: if (isSignedIn() || incoming().authorId == 'anonymous-entry') && isValidId(recordId) && isValidClinicalRecord(incoming());
        allow update: if (isSignedIn() || existing().authorId == 'anonymous-entry') && isValidId(recordId) && 
                       isValidClinicalRecord(incoming()) &&
                       incoming().authorId == existing().authorId;
      }

      match /prescriptions/{prescriptionId} {
        allow get, list: if true;
        allow create: if (isSignedIn() || incoming().authorId == 'anonymous-entry') && isValidId(prescriptionId) && isValidPrescription(incoming());
        allow update: if (isSignedIn() || existing().authorId == 'anonymous-entry') && isValidId(prescriptionId) && isValidPrescription(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adherenceStatus', 'adherenceScore', 'updatedAt']);
        allow delete: if isSignedIn() || existing().authorId == 'anonymous-entry';
      }

      match /investigations/{investigationId} {
        allow get, list: if true;
        allow create: if (isSignedIn() || incoming().authorId == 'anonymous-entry') && isValidId(investigationId) && isValidInvestigation(incoming());
        allow update: if (isSignedIn() || existing().authorId == 'anonymous-entry') && isValidId(investigationId) && isValidInvestigation(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'instructions', 'resultSummary', 'resultDate', 'updatedAt']);
      }

      match /procedures/{procedureId} {
        allow get, list: if true;
        allow create: if (isSignedIn() || incoming().authorId == 'anonymous-entry') && isValidId(procedureId) && isValidProcedure(incoming());
        allow update: if (isSignedIn() || existing().authorId == 'anonymous-entry') && isValidId(procedureId) && isValidProcedure(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'targetDate', 'updatedAt']);
      }

      match /referrals/{referralId} {
        allow get, list: if true;
        allow create: if (isSignedIn() || incoming().authorId == 'anonymous-entry') && isValidId(referralId) && isValidReferral(incoming());
        allow update: if (isSignedIn() || existing().authorId == 'anonymous-entry') && isValidId(referralId) && isValidReferral(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt']);
      }

      match /vitals/{vitalId} {
        allow get, list: if true;
        allow create: if (isSignedIn() || (incoming().authorId == 'anonymous-entry' && isValidVitals(incoming())));
      }

      match /interactions/{interactionId} {
        allow get, list: if true;
        allow create: if (isSignedIn() || incoming().authorId == 'anonymous-entry') && isValidId(interactionId) && isValidInteraction(incoming());
      }
    }
  }
}
