rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helper functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'anonymous');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getRole() {
      return (request.path.size() > 4 && request.path[3] == 'roles' && request.path[4] == request.auth.uid)
        ? (resource != null ? resource.data.get('role', 'none') : (request.resource != null ? request.resource.data.get('role', 'none') : 'none'))
        : (exists(/databases/$(database)/documents/roles/$(request.auth.uid)) 
            ? get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.get('role', 'none') 
            : ((request.path.size() > 4 && request.path[3] == 'users' && request.path[4] == request.auth.uid)
                ? (resource != null ? resource.data.get('role', 'none') : (request.resource != null ? request.resource.data.get('role', 'none') : 'none'))
                : (exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
                    ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') 
                    : 'none')));
    }

    function hasRole(role) {
      return isSignedIn() && getRole() == role;
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email != null && request.auth.token.email.toLowerCase() == "karlanwartheodore@gmail.com") ||
        hasRole('admin')
      );
    }

    function isAuthor(data) {
      return data != null && (
        (isSignedIn() && data.get('authorId', '') == request.auth.uid) || 
        (data.get('authorId', 'anonymous-entry') == 'anonymous-entry')
      );
    }

    function isManager() { return isAdmin() || hasRole('manager'); }

    function isStaff() {
      return isSignedIn() && (getRole() in ['admin', 'manager', 'clinician', 'nurse', 'allied_health', 'billing', 'front_desk', 'read_only', 'pt']);
    }

    // Role-specific staff helpers
    function isClinician() { return isAdmin() || hasRole('manager') || hasRole('clinician'); }
    function isNurse() { return isClinician() || hasRole('nurse'); }
    function isAlliedHealth() { return isClinician() || hasRole('allied_health') || hasRole('pt'); }
    function isFinancialStaff() { return isAdmin() || hasRole('billing'); }

    function isCareTeamMember(patientId) {
      return isSignedIn() && (
        request.auth.uid == patientId ||
        isAdmin() ||
        exists(/databases/$(database)/documents/patients/$(patientId)/care_teams/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          exists(/databases/$(database)/documents/patients/$(patientId)/care_teams/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('originalId', 'none'))) ||
          exists(/databases/$(database)/documents/patients/$(patientId)/care_teams/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('id', 'none')))
        )) ||
        isClinician() || isNurse() || isAlliedHealth()
      );
    }

    function isLinkedPatient(patientId) {
      return isSignedIn() && (
        request.auth.uid == patientId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('patientId', '') == patientId) ||
        (exists(/databases/$(database)/documents/patients/$(patientId)) &&
         'authorizedUserIds' in get(/databases/$(database)/documents/patients/$(patientId)).data &&
         get(/databases/$(database)/documents/patients/$(patientId)).data.authorizedUserIds.hasAny([request.auth.uid]))
      );
    }

    function hasPatientAccess(patientId) {
      return isCareTeamMember(patientId) || isLinkedPatient(patientId);
    }

    // --- Global Admin Bypass ---
    match /{document=**} {
      // ONLY Admin can bypass, forcing rules evaluation for staff, clinicians, and patients
      allow read, write: if isSignedIn() && isAdmin();
    }

    // --- Entity Validations ---
    function isValidUser(data) {
      return data.keys().hasAll(['role']) &&
             data.role in ['clinician', 'nurse', 'allied_health', 'admin', 'billing', 'patient', 'manager', 'front_desk', 'read_only', 'pt'];
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); 
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(request.resource.data);
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidUser(request.resource.data);
      allow delete: if isAdmin();
    }

    match /roles/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow list: if isSignedIn() && isStaff();
      allow write: if isAdmin();
    }

    match /patients/{patientId} {
      allow get: if isSignedIn() && (isStaff() || isLinkedPatient(patientId));
      allow list: if isSignedIn() && isStaff();
      allow create: if isSignedIn() && (hasRole('admin') || hasRole('front_desk') || hasRole('manager') || request.auth.uid == patientId);
      allow update: if isSignedIn() && (hasRole('admin') || hasRole('front_desk') || hasRole('manager') || request.auth.uid == patientId);
      
      match /care_teams/{memberId} {
        allow read: if isSignedIn() && (isStaff() || isLinkedPatient(patientId));
        allow write: if isSignedIn() && (isStaff() || request.auth.uid == memberId);
      }

      match /clinical_records/{recordId} {
        allow read: if hasPatientAccess(patientId);
        allow create: if isCareTeamMember(patientId) && (isClinician() || isNurse() || isAlliedHealth());
        allow update: if isAdmin() || (isAuthor(existing()) && !existing().get('isFinalized', false));
      }

      match /prescriptions/{prescriptionId} {
        allow read: if hasPatientAccess(patientId);
        // Patients and proxies can submit refill requests (refillRequested: true)
        allow create: if hasPatientAccess(patientId) && (isClinician() || isNurse() || isLinkedPatient(patientId));
        allow update: if isCareTeamMember(patientId) && (isClinician() || isNurse());
      }

      match /investigations/{investigationId} {
        allow read: if hasPatientAccess(patientId);
        allow write: if isCareTeamMember(patientId) && (isClinician() || isAdmin());
      }

      match /procedures/{procedureId} {
        allow read: if hasPatientAccess(patientId);
        allow write: if isCareTeamMember(patientId) && (isClinician() || isNurse());
      }

      match /vitals/{vitalId} {
        allow read: if hasPatientAccess(patientId);
        allow create: if hasPatientAccess(patientId) && (isClinician() || isNurse() || isAlliedHealth() || isLinkedPatient(patientId));
        allow update: if isCareTeamMember(patientId) && (isClinician() || isNurse());
      }

      match /referrals/{referralId} {
        allow read: if hasPatientAccess(patientId) && !isNurse(); // Nurses cannot see referrals
        allow write: if isCareTeamMember(patientId) && (isClinician() || isAlliedHealth());
      }

      match /interactions/{interactionId} {
        allow read: if hasPatientAccess(patientId);
        allow create: if hasPatientAccess(patientId);
      }

      match /health_records/{recordId} {
        allow read: if hasPatientAccess(patientId);
        allow create: if hasPatientAccess(patientId) || isSignedIn();
      }

      match /clinical_intakes/{intakeId} {
        allow read: if hasPatientAccess(patientId);
        allow write: if hasPatientAccess(patientId) || isStaff();
      }
    }

    match /charges/{chargeId} {
      allow read, write: if isSignedIn();
    }

    match /invoices/{invoiceId} {
      allow read, write: if isSignedIn();
    }

    match /billing/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /auditLogs/{logId} {
      allow write: if false; // Only server/admin functions
      allow read: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /inventory/{itemId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    match /reminders/{reminderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    match /sops/{sopId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /clinical_templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /results/{resultId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /checkins/{checkinId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /consents/{consentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /fhir_sync_logs/{logId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}

